{
  "appId": "com.motomind.MotorSetup",
  "productName": "Motor Setup Tool",
  "directories": { "output": "../dist-electron/installers" },
  "asar": false,
  "publish": null,
  "linux": {
    "category": "Utility",
    "icon": "../assets/icons/256.png",
    "executableName": "motor-setup-tool",
    "syncDesktopName": true,
    "desktop": { "entry": { "Name": "Motor Setup Tool", "Comment": "Motomind motor setup and calibration" } }
  },
  "mac": {
    "identity": null,
    "icon": "../assets/icons/motor-setup-tool.icns",
    "category": "public.app-category.utilities"
  },
  "dmg": { "title": "Motor Setup Tool" },
  "win": { "target": "nsis", "icon": "../assets/icons/motor-setup-tool.ico" },
  "nsis": {
    "installerIcon": "../assets/icons/motor-setup-tool.ico",
    "uninstallerIcon": "../assets/icons/motor-setup-tool.ico",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}
